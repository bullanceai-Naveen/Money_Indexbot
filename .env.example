# ============================================
# SUPABASE CONFIGURATION
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ============================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# RAZORPAY CONFIGURATION
# Get these from: https://dashboard.razorpay.com/app/keys
# Use TEST keys for development, LIVE keys for production
# ============================================
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# TELEGRAM BOT CONFIGURATION
# Create bot via @BotFather on Telegram
# Get chat ID by messaging @userinfobot
# ============================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_ADMIN_CHAT_ID=123456789

# ============================================
# EMAIL CONFIGURATION (Resend.com)
# Get API key from: https://resend.com/api-keys
# ============================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=MoneyIndex <noreply@yourdomain.com>
ADMIN_EMAIL=hello@bullance.in

# ============================================
# ENCRYPTION KEY
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or: openssl rand -hex 32
# KEEP THIS SECRET - Used to encrypt Upstox tokens
# ============================================
ENCRYPTION_KEY=your-64-character-hex-string-here-generate-using-command-above

# ============================================
# UPSTOX OAUTH (Optional - for token refresh flow)
# Get from: https://api.upstox.com/developer/apps
# ============================================
UPSTOX_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
UPSTOX_CLIENT_SECRET=xxxxxxxxxxxxxxxx
UPSTOX_REDIRECT_URI=https://your-app.netlify.app/api/upstox-callback

# ============================================
# APPLICATION SETTINGS
# ============================================
SITE_URL=https://your-app.netlify.app
PRODUCT_PRICE_PAISE=49900
PRODUCT_NAME=MoneyIndex Premium - 30 Days
